{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "easyaudio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-03",

  // This app lives under the portfolio's catch-all Worker. Both the exact and
  // descendant routes are more specific, so EasyAudio wins only for its path.
  "routes": [
    { "pattern": "charliepolito.com/easyaudio", "zone_name": "charliepolito.com" },
    { "pattern": "charliepolito.com/easyaudio/*", "zone_name": "charliepolito.com" }
  ],
  "workers_dev": true,
  "preview_urls": false,

  "ratelimits": [
    {
      "name": "API_USER_LIMITER",
      "namespace_id": "17001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "API_IP_LIMITER",
      "namespace_id": "17002",
      "simple": { "limit": 300, "period": 60 }
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
