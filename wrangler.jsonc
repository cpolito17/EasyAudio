{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "easyaudio",
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-15",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}
